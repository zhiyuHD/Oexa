{
  "name": "@zhiyuxl/oexa",
  "version": "0.1.0",
  "description": "A Vue 3 + Vite static blog generator with Hexo syntax compatibility",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./components/*": "./dist/components/*",
    "./composables/*": "./dist/composables/*"
  },
  "files": [
    "dist",
    "templates"
  ],
  "bin": {
    "oexa": "./dist/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-s build:lib build:types",
    "build:lib": "vite build",
    "build:types": "vue-tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "generate": "tsx src/build/generate.ts"
  },
  "dependencies": {
    "marked": "^17.0.3",
    "mdui": "^2.1.4",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.0",
    "gray-matter": "^4.0.3",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.13",
    "@vitejs/plugin-vue": "^6.0.4",
    "jiti": "^2.6.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vue-tsc": "^3.2.4"
  },
  "peerDependencies": {
    "vite": "^6.0.0",
    "vue": "^3.5.0"
  },
  "keywords": [
    "blog",
    "static-site-generator",
    "vue",
    "vite",
    "hexo",
    "markdown"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  }
}
